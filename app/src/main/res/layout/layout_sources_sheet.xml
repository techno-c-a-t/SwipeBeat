<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#18181B"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#27272A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выбрать источники"
        android:textColor="#F4F4F5"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSheetDeviceLibrary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_button_secondary"
        android:text="Вся медиатека устройства"
        android:textAllCaps="false"
        android:textColor="#F4F4F5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSheetAddFolder"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_button_secondary"
        android:text="Выбрать папку (SAF)"
        android:textAllCaps="false"
        android:textColor="#F4F4F5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSheetImportM3u8"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_button_secondary"
        android:text="Импортировать .m3u8"
        android:textAllCaps="false"
        android:textColor="#F4F4F5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvActiveSourcesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Текущие источники"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/activeSourcesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvCreatedPlaylistsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Созданные плейлисты"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/createdPlaylistsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvRecentFoldersHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Недавние папки"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/recentFoldersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
